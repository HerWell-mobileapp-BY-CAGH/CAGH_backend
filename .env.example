# Security & Django Settings
DEBUG=True
SECRET_KEY=django-insecure-cagh-backend-super-secret-key-change-in-production!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_DB=cagh_db
POSTGRES_USER=cagh_user
POSTGRES_PASSWORD=cagh_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://cagh_user:cagh_secure_password@db:5432/cagh_db

# Redis & Celery Settings
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS & Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.example\.com$

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:3000

# Password Reset Token Expiry (seconds — default 86400 = 24 hours)
PASSWORD_RESET_TIMEOUT=86400

# Email Settings
# Development: use console backend (prints to terminal, no SMTP needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: switch to smtp backend and fill SMTP credentials below
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CAGH <noreply@cagh.health>
