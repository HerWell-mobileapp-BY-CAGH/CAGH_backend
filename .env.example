# Security & Django Settings
DEBUG=True
SECRET_KEY=django-insecure-cagh-backend-super-secret-key-change-in-production!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,cagh-backend-api.onrender.com,.onrender.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=cagh_db
POSTGRES_USER=cagh_user
POSTGRES_PASSWORD=cagh_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://cagh_user:cagh_secure_password@db:5432/cagh_db

# Redis & Celery Settings
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS & Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.example\.com$

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:3000

# Password Reset Token Expiry (seconds — default 86400 = 24 hours)
PASSWORD_RESET_TIMEOUT=86400

# Email Settings
# Development: use console backend (prints to terminal, no SMTP needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: switch to IPv4/SMTP backend and fill SMTP credentials below
# EMAIL_BACKEND=apps.common.email.IPv4EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CAGH <noreply@cagh.health>

# Agora Voice & Video Session Settings
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Firebase Cloud Messaging (FCM) & Google Cloud Credentials
# Path to service account JSON file OR base64-encoded JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
GOOGLE_CLOUD_PROJECT=cagh-bd916

# AI Assistant Settings (Phase 1 Foundation)
AI_MAX_INPUT_LENGTH=1000
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT=20/minute
AI_MAX_HISTORY_MESSAGES=6
AI_KNOWLEDGE_CONTEXT_LIMIT=3

